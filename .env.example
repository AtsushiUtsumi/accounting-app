# 本番の設定値のひな形。本番サーバーで .env という名前にコピーし、値を書き換えて使う。
# .env はパスワードを含むので Git に入れない(.gitignore 済み)。
#
# 値は必ずシングルクォートで囲む。囲まないと、bcrypt の $ が変数として展開されて壊れる。

# 使うイメージのタグ(latest、またはコミットのハッシュ)
ACCOUNTING_IMAGE_TAG='latest'

# 外から受けるポート
ACCOUNTING_HTTP_PORT='80'

# DB のパスワード(最初に起動したときの値で DB が作られる。後から変えるときは DB 側も変更が必要)
ACCOUNTING_DB_PASSWORD='change-me'

# サインインするユーザー。パスワードは {bcrypt} 付きのハッシュで書く。ハッシュの作り方:
#   docker run --rm httpd:2.4-alpine htpasswd -nbBC 10 "" 'パスワード' | tr -d ':\n'
# 出力の先頭に {bcrypt} を付ける(例: {bcrypt}$2y$10$....)。
# 平文で書くなら {noop}パスワード(おすすめしない)。
ACCOUNTING_VIEWER_NAME='viewer'
ACCOUNTING_VIEWER_PASSWORD='{bcrypt}$2y$10$replace-with-your-hash'
ACCOUNTING_BOOKKEEPER_NAME='bookkeeper'
ACCOUNTING_BOOKKEEPER_PASSWORD='{bcrypt}$2y$10$replace-with-your-hash'
ACCOUNTING_APPROVER_NAME='approver'
ACCOUNTING_APPROVER_PASSWORD='{bcrypt}$2y$10$replace-with-your-hash'
